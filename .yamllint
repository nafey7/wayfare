---
# Yamllint configuration for Voya project

extends: default

rules:
  line-length:
    max: 120  # Allow longer lines for readability
    level: warning
  document-start:
    present: false  # Don't require --- at start of every file
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: true
