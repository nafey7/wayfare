{
  "name": "19.2_adventure",
  "description": "Adventure interests → hiking/outdoor focused itinerary",
  "messages": [
    {
      "send": "Plan an adventure trip to Queenstown, {{today+30:natural}} to {{today+35:natural}}, 2 adults",
