{
  "name": "12.4_text_reply_not_regen",
  "description": "After itinerary, 'looks great thanks' → text reply, NOT regeneration",
  "messages": [
    {
      "send": "Plan a 3-day trip to Tokyo, {{today+30:natural}} to {{today+33:natural}}, 1 adult",
      "expect_type_in": ["itinerary_results", "ai_response", "message", "itinerary_conversation"],
      "expect_intent": "create_itinerary",
      "max_time_ms": 180000
    },
    {
      "send": "Looks great, thanks!",
      "expect_type_in": ["ai_response", "message", "itinerary_conversation"],
      "max_time_ms": 180000,
      "expect_contains_any": ["glad", "great", "enjoy", "happy", "welcome", "book", "ready", "anything else", "help"]
    }
  ]
}
