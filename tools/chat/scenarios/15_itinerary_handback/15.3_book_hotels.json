{
  "name": "15.3_book_hotels",
  "description": "After itinerary, 'find hotels' → routes to hotel agent",
  "messages": [
    {
      "send": "Plan a 3-day trip to Tokyo, {{today+30:natural}} to {{today+33:natural}}, 2 adults",
      "expect_type_in": ["itinerary_results", "ai_response", "message", "itinerary_conversation"],
      "expect_intent": "create_itinerary",
      "max_time_ms": 180000
    },
    {
      "send": "Find hotels in Tokyo",
      "expect_type_in": ["hotel_conversation", "hotel_search_results", "ai_response", "message", "itinerary_conversation"],
      "max_time_ms": 180000,
      "expect_contains_any": ["hotel", "Tokyo", "check-in", "checkin", "room", "search", "accommodation", "dates", "guests"]
    }
  ]
}
