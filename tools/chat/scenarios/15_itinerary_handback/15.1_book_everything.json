{
  "name": "15.1_book_everything",
  "description": "After itinerary, 'book everything' → hands back to supervisor for flight+hotel",
  "messages": [
    {
      "send": "Plan a 3-day trip to Paris from London, {{today+30:natural}} to {{today+33:natural}}, 2 adults",
      "expect_type_in": ["itinerary_results", "ai_response", "message", "itinerary_conversation"],
      "expect_intent": "create_itinerary",
      "max_time_ms": 180000
    },
    {
      "send": "Book everything",
      "expect_type_in": ["flight_conversation", "flight_search_results", "hotel_conversation", "hotel_search_results", "ai_response", "message", "itinerary_conversation"],
      "max_time_ms": 180000,
      "expect_contains_any": ["flight", "hotel", "book", "search", "London", "Paris", "booking"]
    }
  ]
}
