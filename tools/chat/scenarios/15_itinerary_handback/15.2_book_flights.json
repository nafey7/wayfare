{
  "name": "15.2_book_flights",
  "description": "After itinerary, 'book flights' → routes to flight agent",
  "messages": [
    {
      "send": "Plan a 3-day trip to Barcelona from Amsterdam, {{today+30:natural}} to {{today+33:natural}}, 1 adult",
      "expect_type_in": ["itinerary_results", "ai_response", "message", "itinerary_conversation"],
      "expect_intent": "create_itinerary",
      "max_time_ms": 180000
    },
    {
      "send": "Book flights",
      "expect_type_in": ["flight_conversation", "flight_search_results", "ai_response", "message", "itinerary_conversation"],
      "max_time_ms": 180000,
      "expect_contains_any": ["flight", "Amsterdam", "Barcelona", "search", "booking", "origin", "destination"]
    }
  ]
}
