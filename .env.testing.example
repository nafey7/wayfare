# Voya Testing Environment Configuration
#
# This file configures the testing environment for Playwright tests.
# It ensures complete isolation from development data by using separate services.
#
# Key differences from development:
# - Separate test database (voya_test)
# - Dedicated test ports to avoid conflicts
# - Test-specific email service configuration
# - Isolated service instances

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=voya-test
NODE_ENV=testing
ENVIRONMENT=testing
DEBUG=true

# =============================================================================
# SERVICE PORTS (Isolated from development)
# =============================================================================
# Frontend - Test instance
FRONTEND_PORT=3001

# Backend - Test instance
BACKEND_PORT=8001

# Database - Test instance
MONGODB_PORT=27018

# Email Testing - Test instance
MAILHOG_WEB_PORT=8026
MAILHOG_SMTP_PORT=1026

# Database Management - Test instance
MONGO_EXPRESS_PORT=8082

# FlightLogic Mock - Test instance (port 8004, dev uses 8002, dev inspector uses 8003)
FLIGHTLOGIC_MOCK_PORT=8004

# =============================================================================
# DATABASE CONFIGURATION (Isolated Test Database)
# =============================================================================
DATABASE_NAME=voya_test
MONGODB_URI=mongodb://localhost:27018
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=1

# For Docker Compose test stack
MONGODB_URI_DOCKER=mongodb://mongodb-test:27017

# =============================================================================
# EMAIL CONFIGURATION (Test Email Service)
# =============================================================================
# Use MailHog for all test email functionality
USE_MAILHOG=true
MAILHOG_HOST=localhost
MAILHOG_PORT=1026

# For Docker Compose test stack
MAILHOG_HOST_DOCKER=mailhog-test
MAILHOG_PORT_DOCKER=1025

# Disable SendGrid in testing
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=test@example.com

# =============================================================================
# SECURITY CONFIGURATION (Test-specific)
# =============================================================================
SECRET_KEY=test-secret-key-for-testing-environment-only-not-for-production
JWT_SECRET=test-jwt-secret-for-testing-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# API KEYS (Test/Mock Configuration)
# =============================================================================
# Google AI - Use test/mock key or leave empty for testing
GOOGLE_AI_API_KEY=

# Google OAuth - Test configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/auth/google/authenticate

# FlightLogic Mock API (Test Environment)
# Uses mock server on port 8004 (host, dev uses 8002)
FLIGHTLOGIC_API_URL=http://flightlogic-mock-test:8002/api/aeroVE5
FLIGHTLOGIC_ACCESS_TYPE=Test
FLIGHTLOGIC_API_KEY=mock-api-key-test
FLIGHTLOGIC_USER_ID=mock_user
FLIGHTLOGIC_PASSWORD=mock_password

# =============================================================================
# APPLICATION SETTINGS (Test-specific)
# =============================================================================
PROJECT_NAME=Voya-Test
VERSION=1.0.0-test
API_V1_STR=/api

# Frontend URL for test environment (backend serves SPA at 8001)
FRONTEND_URL=http://localhost:8001

# Server Configuration
HOST=0.0.0.0
PORT=8001

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# User/Group IDs for Docker containers
USER_ID=1000
GROUP_ID=1000

# Docker image versions
MONGO_VERSION=7.0
MONGO_EXPRESS_VERSION=1.0.0
MAILHOG_VERSION=v1.0.1

# =============================================================================
# TESTING SPECIFIC SETTINGS
# =============================================================================
# Admin emails for testing
ADMIN_EMAILS=admin@test.example.com

# Frontend API URL for testing (frontend-v2 uses VITE_* prefix)
VITE_API_URL=http://localhost:8001/api

# MongoDB Express Configuration (Test Database Management)
MONGO_EXPRESS_BASICAUTH=false
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=pass

# MailHog Configuration
MAILHOG_STORAGE=memory
MAILHOG_HOSTNAME=mailhog-test

# Test Database Cleanup Settings
AUTO_CLEANUP_TEST_DATA=true
CLEANUP_AFTER_EACH_TEST=true
PRESERVE_TEST_SCHEMA=true
