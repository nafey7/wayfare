; MOCK credentials for local Docker (MinIO) only — NOT real AWS keys.
; Mounted into backend + imgproxy containers at the path set in
; AWS_SHARED_CREDENTIALS_FILE so boto3 / imgproxy can authenticate to MinIO
; via the standard AWS credential chain (the SDKs require this env var name).
;
; These match the MinIO root creds on the `minio` service in compose.dev.yaml
; and never leave the local Docker network. Staging and production do NOT use
; AWS access keys — they authenticate to S3 via the ECS task role.

; Both keys below are MinIO local mocks, not real AWS.
[default]
aws_access_key_id = voya-local
aws_secret_access_key = voya-local-secret  # pragma: allowlist secret
