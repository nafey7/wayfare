# Personal notes and experiments
notes/
experiments/
playground/
sandbox/
/docker-compose.yml
# Terraform
**/.terraform/*
# .terraform.lock.hcl is intentionally committed (HashiCorp recommendation).
# Committing it makes provider versions reproducible across dev machines and CI,
# and lets terraform verify providers via the pinned hashes instead of
# re-verifying GPG signatures at every init.
*.tfstate*
*.tfplan
tfplan

# Terraform variable files
terraform.tfvars      # Local overrides (gitignored)
**/terraform.tfvars
*.auto.tfvars         # Auto-loaded local overrides
*.tfvars.json         # JSON format local overrides
# Note: Environment-specific files like staging.tfvars, production.tfvars are committed
airports_cache.json

# Trace review
.secrets
reports/
tools/langfuse/review_lib/__pycache__/

# Claude Code custom commands (local only)
.claude/commands/

# README screenshots
!docs/screenshots/*.jpg
