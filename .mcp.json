{
  "mcpServers": {
    "gtm-mcp-server": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gtm-mcp.stape.ai/mcp"]
    },
    "langfuse": {
      "type": "streamable-http",
      "url": "https://cloud.langfuse.com/api/public/mcp",
      "headers": {
        "Authorization": "Basic ${LANGFUSE_MCP_AUTH}"
      }
    },
    "storybook": {
      "type": "streamable-http",
      "url": "http://localhost:6006/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.70", "--caps", "testing"]
    },
    "playwright-test": {
      "command": "./bin/playwright-test-mcp",
      "args": []
    }
  }
}
