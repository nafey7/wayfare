# Voya Development Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=voya-dev
USER_ID=1000
GROUP_ID=1000

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
MONGODB_PORT=27017
MONGO_EXPRESS_PORT=8081
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025
FLIGHTLOGIC_MOCK_PORT=8002

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_NAME=voya_dev
MONGODB_URI=mongodb://mongodb:27017
DATABASE_URL=mongodb://mongodb:27017
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=1

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
REACT_APP_API_URL=http://localhost:8000/api

# =============================================================================
# ADMIN ACCESS
# =============================================================================
ADMIN_EMAILS=admin@example.com,dev@example.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=DEBUG

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=false

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=80
FRONTEND_URL=http://localhost:3000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Development: Use MailHog (local email testing)
USE_MAILHOG=true
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
DEFAULT_FROM_EMAIL=noreply@voya.travel
EMAIL_FOOTER_TEXT=©️ 2025 Voya Travel. All rights reserved.

# =============================================================================
# SLACK (OPERATIONAL ALERTS)
# =============================================================================
# Optional Incoming Webhook for flight/hotel booking errors and GDS ticket time limit warnings.
SLACK_WEBHOOK_URL=
# GDS ticket time limit job: alert when deadline is within this window (hours). Default: 2.
GDS_TICKET_TIME_LIMIT_ALERT_WINDOW_HOURS=2
# Mongo lease on a booking_events row while sending Slack (minutes). Default: 15.
GDS_TICKET_TIME_LIMIT_ALERT_LEASE_MINUTES=15

# Production: SendGrid (set API key when deploying)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ActiveCampaign (CRM sync on signup) — leave blank to disable integration
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Get credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/authenticate

# =============================================================================
# GOOGLE AI CONFIGURATION
# =============================================================================
# Get API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# LANGFUSE CONFIGURATION (Prompt Management & Tracing)
# =============================================================================
# Prompt label to fetch (production, staging, latest, etc.)
# Used for environment-specific prompts and A/B testing
LANGFUSE_PROMPT_LABEL=production

# =============================================================================
# PYTHON CONFIGURATION
# =============================================================================
PYTHONPATH=.

# =============================================================================
# SECURITY KEYS
# =============================================================================
# IMPORTANT: Generate secure random keys for production!
# Example: openssl rand -hex 32
SECRET_KEY=dev-secret-key-please-change-in-production-minimum-32-chars
JWT_SECRET=dev-jwt-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# STRIPE PAYMENT CONFIGURATION
# =============================================================================
# Get credentials from Stripe Dashboard:
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get webhook secret after creating webhook endpoint:
# https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
STRIPE_USE_CONNECT_TRANSFERS=true
# FlightLogic's Stripe Connect account for receiving payments
# Dev/local: Leave empty (uses test account acct_1RnLvfPOhOFPCIcC)
# Production: acct_1SYDWlPFaJGxewbo
FLIGHTLOGIC_STRIPE_ACCOUNT_ID=

# =============================================================================
# NGROK CONFIGURATION (For local webhook testing)
# =============================================================================
# Get auth token from ngrok dashboard:
# https://dashboard.ngrok.com/get-started/your-authtoken
# Optional: Provides persistent URLs and longer session times
NGROK_AUTH_TOKEN=

# FlightLogic API Configuration
# OPTION 1: Mock Server (Default for Development)
# Uses local mock server - no external API calls required
FLIGHTLOGIC_API_URL=http://flightlogic-mock:8002/api/aeroVE5
FLIGHTLOGIC_ACCESS_TYPE=Test
FLIGHTLOGIC_API_KEY=mock-api-key

# OPTION 2: Real FlightLogic API (Production/Integration Testing)
# Uncomment these and comment mock settings above to use real API:
# FLIGHTLOGIC_API_URL=https://travelnext.works/api/aeroVE5
# FLIGHTLOGIC_USER_ID=your_user_id
# FLIGHTLOGIC_PASSWORD=your_password
# FLIGHTLOGIC_ACCESS_TYPE=Test
# FLIGHTLOGIC_IP_ADDRESS=your_ip_address

# ================================================================
# ADVANCED: Local Overrides
# ================================================================
# You can create backend_python/.env to override these settings
# for your local development without affecting other developers.
#
# Example backend_python/.env:
#   FLIGHTLOGIC_API_URL=https://travelnext.works/api/aeroVE5
#   FLIGHTLOGIC_USER_ID=your_real_user_id
#   FLIGHTLOGIC_PASSWORD=your_real_password
#
# This allows you to test against the real API while others use mock.
# ================================================================
