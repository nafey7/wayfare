# Python Backend Environment Variables
#
# This file demonstrates environment variables for running the backend directly.
# Copy this file to .env and update the values for local development.
#
# DUAL SETUP SUPPORT:
# 1. Backend Direct Execution: Uses this .env file (backend_python/.env)
# 2. Docker Compose Stack: Uses project root .env file (../.env)
#
# The Docker Compose setup will use project root .env as primary source,
# but will also load this file if it exists for backend-specific overrides.

# ================== REQUIRED SETTINGS ==================
# These MUST be set in your .env file

# Environment: development, staging, or production
ENVIRONMENT=development

# Debug mode
DEBUG=True  # MUST be False for production

# Security - REQUIRED (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-minimum-32-chars-for-production

# Passenger PII encryption (Fernet key for passport, frequent flyer numbers)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional in dev (falls back to key derived from SECRET_KEY). Required for production.
PASSENGER_ENCRYPTION_KEY=

# Database - REQUIRED
# Use MONGODB_URI in .env file - the application maps it to DATABASE_URL internally
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# For Docker development:
# MONGODB_URI=mongodb://mongodb:27017
# For AWS/Production use MongoDB Atlas or DocumentDB:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Server Configuration - REQUIRED
HOST=127.0.0.1  # Use 127.0.0.1 for development, 0.0.0.0 for production/docker
PORT=8000

# Frontend URL - REQUIRED
FRONTEND_URL=http://localhost:3000

# CORS Origins - REQUIRED (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000

# Logging Level - REQUIRED (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Rate Limiting - REQUIRED
RATE_LIMIT_ENABLED=False  # Set to True for production

# FlightLogic Access Type - REQUIRED (Test or Production)
FLIGHTLOGIC_ACCESS_TYPE=Test

# ================== ADDITIONAL DATABASE SETTINGS ==================

# Python path
PYTHONPATH=.

# Database Configuration
DATABASE_NAME=voya_dev
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_POOL_SIZE=1



# Logging (for AWS CloudWatch, set LOG_FILE_PATH to empty)
# LOG_FILE_PATH=

# ================== EXTERNAL API KEYS ==================

# Google API Keys - TWO SEPARATE KEYS:
# 1. GEMINI_API_KEY: For AI/chatbot features using Gemini models
# 2. GOOGLE_API_KEY: For non-AI Google services (Maps, Geocoding, Places, YouTube, etc.)
#
# You can use the same key for both if your Google Cloud project has all APIs enabled,
# but it's recommended to use separate keys for better security and quota management.

# Google Gemini AI API Key (for AI chatbot using Gemini models)
GEMINI_API_KEY=

# Google API Key (for Maps API, Geocoding, Places, and other Google services)
GOOGLE_API_KEY=

# Email Configuration (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ActiveCampaign (CRM sync on signup) — leave blank to disable integration
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=

# Email Provider Selection
# Set USE_MAILHOG=true to use MailHog for local email testing instead of SendGrid
# When using MailHog, no SendGrid credentials are required
# Automatically defaults to true in development mode
USE_MAILHOG=false
# For local development (direct Python execution)
MAILHOG_HOST=localhost
# For Docker development, use: mailhog
MAILHOG_PORT=1025

# Environment (development, staging, production)
ENVIRONMENT=development

# Frontend URL (for emails and redirects)
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/authenticate

# FlightLogic API
# DEPRECATED: FLIGHTLOGIC_API_URL - Use separate URLs below for flights and hotels
# FLIGHTLOGIC_API_URL=https://travelnext.works/api/aeroVE5
FLIGHTLOGIC_FLIGHTS_API_BASE_URL=https://travelnext.works/api/aeroVE5
FLIGHTLOGIC_HOTELS_API_BASE_URL=https://travelnext.works/api/hotel-api-v6
FLIGHTLOGIC_API_KEY=
FLIGHTLOGIC_USER_ID=
FLIGHTLOGIC_PASSWORD=
FLIGHTLOGIC_IP_ADDRESS=

# ================== FEATURE FLAGS ==================

# LangGraph Itinerary Agent V2
# When enabled, CREATE_ITINERARY intent routes to V2 dynamic ReAct agent
# instead of V1 supervisor pipeline.
VOYA_FEATURE_FLAG_USE_LANGGRAPH_ITINERARY_V2=false

# V2 Supervisor (multi-agent routing)
# When enabled, bypasses IntentRecognizer and V1 router, routing all messages
# through the V2 Supervisor that classifies intent and delegates to sub-agents.
VOYA_FEATURE_FLAG_USE_V2_SUPERVISOR=false

# ================== SENTRY ERROR TRACKING ==================
# Sentry for error tracking and APM
# Sign up at https://sentry.io (free tier: 5K errors/month)
# Create a FastAPI project and copy the DSN
SENTRY_DSN=
# Performance monitoring sample rate (0.0 to 1.0)
# Use 1.0 for development/staging, 0.1 for production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ================== LANGFUSE OBSERVABILITY ==================
# Langfuse LLM observability for debugging LangGraph agents
# Sign up at https://cloud.langfuse.com (free tier: 50k observations/month)
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Stripe Payment
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# FlightLogic's Stripe Connect account for receiving payments
# Dev/local: Leave empty (uses test account acct_1RnLvfPOhOFPCIcC)
# Production: acct_1SYDWlPFaJGxewbo
FLIGHTLOGIC_STRIPE_ACCOUNT_ID=

# SendGrid Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@voya.com  # Change to your domain email

# ActiveCampaign (CRM sync on signup) — leave blank to disable integration
ACTIVECAMPAIGN_API_URL=  # e.g. https://youraccount.api-ac.com
ACTIVECAMPAIGN_API_KEY=

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@voya.travel  # Default sender email
EMAIL_FOOTER_TEXT=© 2025 Voya Travel. All rights reserved.
DEV_EMAIL_RECIPIENT=dev@myvoya.ai  # Email for development testing
API_TESTER_BASE_URL=http://localhost:8000/dev/api-tester.html  # API tester URL

# ================== PRODUCTION EXAMPLES ==================

# === Example for Production deployment ===
# ENVIRONMENT=production
# SECRET_KEY=<your-production-secret-key-min-32-chars>
# MONGODB_URI=mongodb+srv://prod-user:password@cluster.mongodb.net/voya-prod
# HOST=0.0.0.0
# PORT=8000
# FRONTEND_URL=https://myvoya.ai
# CORS_ORIGINS=https://myvoya.ai,https://api.myvoya.ai
# LOG_LEVEL=WARNING
# SENDGRID_FROM_EMAIL=noreply@myvoya.ai

# === Example for Staging deployment ===
# ENVIRONMENT=staging
# SECRET_KEY=<your-staging-secret-key-min-32-chars>
# MONGODB_URI=mongodb+srv://stage-user:password@cluster.mongodb.net/voya-stage
# HOST=0.0.0.0
# PORT=8000
# FRONTEND_URL=https://staging.myvoya.ai
# CORS_ORIGINS=https://staging.myvoya.ai,https://api-staging.myvoya.ai
# LOG_LEVEL=INFO
# SENDGRID_FROM_EMAIL=noreply@staging.myvoya.ai
