# API Configuration
VITE_API_URL=http://localhost:8000/api

# Strapi (landing / home CMS). When unset, the app uses bundled landing copy.
# Example: http://localhost:1337
VITE_STRAPI_URL=
# Optional read-only API token (public in the browser — scope to landing-page only)
VITE_STRAPI_API_TOKEN=

# Optional: override the landing-page populate query string (no leading ?). Default matches
# Strapi 5 REST (see LANDING_PAGE_POPULATE_STRAPI5_PATHS in strapiApi.ts). Use this for Strapi 4
# or a custom populate shape; paste a working query from Strapi Admin → API if needed.
# VITE_STRAPI_LANDING_POPULATE=

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Google Maps (hotel search map view)
VITE_GOOGLE_MAPS_API_KEY=
# Google Maps Map ID — required for Airbnb-style price pins (AdvancedMarker).
# Create in Cloud Console → Google Maps Platform → Map Management.
VITE_GOOGLE_MAPS_MAP_ID=

# Environment
VITE_ENV=development

# Reddit Pixel (optional - for conversion tracking)
VITE_REDDIT_PIXEL_ID=
