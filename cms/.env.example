# Strapi CMS - Local Development Environment
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=1337
APP_URL=http://localhost:1337

# Secrets (generate with: openssl rand -base64 32)
APP_KEYS=key1,key2
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Database (PostgreSQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi_admin
DATABASE_PASSWORD=
DATABASE_SSL=false

# S3 Upload (optional for local dev)
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# CDN URL for media (optional for local dev)
CDN_URL=
